# Firebase Configuration - Copy this to .env and fill in your values
# Get these from: Firebase Console → Project Settings → Your Apps → SDK setup
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration - Get from: cloudinary.com/console
# Create an "Upload Preset" set to "Unsigned" and name it "technispace_unsigned"
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=technispace_unsigned

# Paystack Configuration - Get your Public Key from: dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_sample_technispace_key
